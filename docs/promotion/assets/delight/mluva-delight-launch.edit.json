  "voice_cuts": [
    {
      "source_start": 0,
      "source_end": 4.2,
      "at": 0.45,
      "text": "Meet Mluva. The most delightful dictation app for Omarchy.",
      "source": "source/pronunciation.mp3"
    },
    {
      "source_start": 4.14,
      "source_end": 8.92,
      "at": 5.6,
      "text": "A tiny presence on your desktop. Speak, and your words stay right with you."
    },
    {
      "source_start": 8.92,
      "source_end": 11.48,
      "at": 10.7,
      "text": "Open the workspace. Keep the thought going."
    },
    {
      "source_start": 11.48,
      "source_end": 19.6,
      "at": 15.25,
      "text": "Live rewrite turns a rough idea into a clear draft, as you speak. Both sides stay steady. Your original stays yours."
    },
    {
      "source_start": 19.6,
      "source_end": 20.5,
      "at": 24.25,
      "text": "Copy it."
    },
    {
      "source_start": 20.5,
      "source_end": 21.29,
      "at": 27.25,
      "text": "Polish it."
    },
    {
      "source_start": 21.29,
      "source_end": 22.12,
      "at": 29.75,
      "text": "Rewrite it."
    },
    {
      "source_start": 22.12,
      "source_end": 26.42,
      "at": 32.25,
      "text": "Make the final edit, and save. Your notes are ready when you return."
    },
    {
      "source_start": 26.42,
      "source_end": 29.64,
      "at": 37.25,
      "text": "Control P puts the next action under your fingers."
    },
    {
      "source_start": 4.2,
      "source_end": 7.68,
      "at": 42.25,
      "text": "And when Omarchy changes its theme, Mluva follows.",
      "source": "source/pronunciation.mp3"
    },
    {
      "source_start": 32.68,
      "source_end": 36.806,
      "at": 50.25,
      "text": "Quiet design. Clear words. A little more delight, every day."
    }
  ],
