diff --git a/tests/cli/guarded_prompts.rs b/tests/cli/guarded_prompts.rs
new file mode 100644
index 00000000..5db02f31
--- /dev/null
+++ b/tests/cli/guarded_prompts.rs
@@ -0,0 +1,442 @@
+//! Guarded prompts to Claude sessions, driven by a synthetic Claude TUI and a synthetic
+//! Claude detection manifest so the bundled Claude rules never decide the outcome.
+use super::harness::*;
+use crate::support::wait_until;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const SESSION: &str = "11111111-2222-4333-8444-555555555555";
+
+// Idle on a prompt-box marker, blocked on a fixture marker.
+const MANIFEST: &str = r#"
+id = "claude"
+
+[[rules]]
+id = "fixture_blocked"
+state = "blocked"
+priority = 990
+region = "whole_recent"
+visible_blocker = true
+contains = ["FIXTURE_BLOCKED"]
+
+[[rules]]
+id = "fixture_prompt"
+state = "idle"
+priority = 950
+region = "prompt_box_body"
+visible_idle = true
+line_regex = ['^\s*❯']
+"#;
+
+// Draws a prompt box whose footer `<files>/<slot>.mode` selects, enables bracketed
+// paste, and appends every byte it receives to `<files>/<slot>.input`.
+const FAKE_AGENT: &str = r#"#!/bin/sh
+slot="${1:-$(basename "$0")}"
+mode_file="FILES/$slot.mode"
+input_file="FILES/$slot.input"
+stty raw -echo
+printf '\033[?2004h'
+exec 3<&0
+cat <&3 >>"$input_file" &
+rule='────────────────────────────────────────'
+last=unset
+while :; do
+  mode=$(cat "$mode_file" 2>/dev/null || true)
+  if [ "$mode" != "$last" ]; then
+    last=$mode
+    case "$mode" in
+      starting) printf '\033[2J\033[Hstarting\r\n' ;;
+      *)
+        case "$mode" in
+          insert) footer='-- INSERT --' ;;
+          visual) footer='-- VISUAL --' ;;
+          blocked) footer='FIXTURE_BLOCKED' ;;
+          *) footer='? for shortcuts' ;;
+        esac
+        printf '\033[2J\033[H\r\n%s\r\n\342\235\257 \r\n%s\r\n  %s\r\n' "$rule" "$rule" "$footer"
+        ;;
+    esac
+  fi
+  sleep 0.1
+done
+"#;
+
+struct Fixture {
+    base: PathBuf,
+    herdr: SpawnedHerdr,
+    socket: PathBuf,
+    files: PathBuf,
+    workspace_pane: String,
+}
+
+impl Fixture {
+    fn start() -> Self {
+        let base = unique_test_dir();
+        let config_home = base.join("config");
+        let runtime_dir = base.join("runtime");
+        let socket = runtime_dir.join("herdr.sock");
+        let bin = base.join("bin");
+        let files = base.join("files");
+        fs::create_dir_all(&bin).unwrap();
+        fs::create_dir_all(&files).unwrap();
+        let manifests = config_home.join(app_dir_name()).join("agent-detection");
+        fs::create_dir_all(&manifests).unwrap();
+        fs::write(manifests.join("claude.toml"), MANIFEST).unwrap();
+        let script = FAKE_AGENT.replace("FILES", &files.display().to_string());
+        for name in ["claude", "pi"] {
+            use std::os::unix::fs::PermissionsExt;
+            let path = bin.join(name);
+            fs::write(&path, &script).unwrap();
+            fs::set_permissions(&path, fs::Permissions::from_mode(0o755)).unwrap();
+        }
+        let path = format!(
+            "{}:{}",
+            bin.display(),
+            std::env::var("PATH").unwrap_or_default()
+        );
+        let herdr =
+            spawn_herdr_with_path(&config_home, &runtime_dir, &socket, Some(Path::new(&path)));
+        wait_for_socket(&socket, Duration::from_secs(5));
+        let created = rpc(
+            &socket,
+            "workspace.create",
+            serde_json::json!({ "cwd": base.display().to_string(), "focus": true }),
+        );
+        let workspace_pane = created["result"]["root_pane"]["pane_id"]
+            .as_str()
+            .expect("root pane")
+            .to_string();
+        Self {
+            base,
+            herdr,
+            socket,
+            files,
+            workspace_pane,
+        }
+    }
+
+    fn split(&self) -> String {
+        let split = rpc(
+            &self.socket,
+            "pane.split",
+            serde_json::json!({
+                "target_pane_id": self.workspace_pane,
+                "direction": "right",
+                "focus": false,
+                "cwd": self.base.display().to_string(),
+            }),
+        );
+        split["result"]["pane"]["pane_id"]
+            .as_str()
+            .expect("split pane")
+            .to_string()
+    }
+
+    fn set_mode(&self, slot: &str, mode: &str) {
+        fs::write(self.files.join(format!("{slot}.mode")), mode).unwrap();
+    }
+
+    fn input(&self, slot: &str) -> String {
+        fs::read_to_string(self.files.join(format!("{slot}.input"))).unwrap_or_default()
+    }
+
+    fn run(&self, pane: &str, command: &str) {
+        let started = run_cli(&self.socket, &["pane", "run", pane, command]);
+        assert!(started.status.success(), "{started:?}");
+    }
+
+    fn agent(&self, pane: &str) -> Option<serde_json::Value> {
+        rpc(&self.socket, "agent.list", serde_json::json!({}))["result"]["agents"]
+            .as_array()?
+            .iter()
+            .find(|agent| agent["pane_id"] == pane)
+            .cloned()
+    }
+
+    fn wait_for_status(&self, pane: &str, agent: &str, status: &str) {
+        assert!(
+            wait_until(Duration::from_secs(15), Duration::from_millis(100), || {
+                self.agent(pane)
+                    .is_some_and(|info| info["agent"] == agent && info["agent_status"] == status)
+            }),
+            "{pane} never became {agent} {status}: {:?}",
+            self.agent(pane)
+        );
+    }
+
+    fn report_session(&self, pane: &str) {
+        let reported = run_cli(
+            &self.socket,
+            &[
+                "pane",
+                "report-agent-session",
+                pane,
+                "--source",
+                "herdr:claude",
+                "--agent",
+                "claude",
+                "--agent-session-id",
+                SESSION,
+            ],
+        );
+        assert!(reported.status.success(), "{reported:?}");
+    }
+
+    /// The server epoch and this pane's guard, when Herdr admits it.
+    fn guard(&self, pane: &str) -> (String, Option<String>) {
+        let listed = rpc(&self.socket, "agent.guarded_list", serde_json::json!({}));
+        let epoch = listed["result"]["server_epoch"]
+            .as_str()
+            .expect("server epoch")
+            .to_string();
+        let guard = listed["result"]["agents"]
+            .as_array()
+            .expect("guarded agents")
+            .iter()
+            .find(|entry| entry["agent"]["pane_id"] == pane)
+            .and_then(|entry| entry["guard"].as_str())
+            .map(str::to_string);
+        (epoch, guard)
+    }
+
+    fn wait_for_guard(&self, pane: &str, admitted: bool) -> String {
+        let mut last = None;
+        assert!(
+            wait_until(Duration::from_secs(10), Duration::from_millis(100), || {
+                last = self.guard(pane).1;
+                last.is_some() == admitted
+            }),
+            "{pane} guarded admission never became {admitted}"
+        );
+        last.unwrap_or_default()
+    }
+
+    /// Waits until the pane's detection text shows `marker`, so the footer change has landed.
+    fn wait_for_screen(&self, pane: &str, marker: &str) {
+        assert!(
+            wait_until(Duration::from_secs(5), Duration::from_millis(50), || {
+                let read = run_cli(
+                    &self.socket,
+                    &[
+                        "agent",
+                        "read",
+                        pane,
+                        "--source",
+                        "detection",
+                        "--format",
+                        "text",
+                    ],
+                );
+                String::from_utf8_lossy(&read.stdout).contains(marker)
+            }),
+            "{pane} never showed {marker}"
+        );
+    }
+
+    /// Submits a guarded prompt and returns its settled receipt state.
+    fn prompt(&self, pane: &str, guard: &str, text: &str) -> String {
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let (epoch, _) = self.guard(pane);
+        let operation_id = format!(
+            "00000000-0000-4000-8000-{:012x}",
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        );
+        let expires = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_millis() as u64
+            + 5_000;
+        let first = rpc(
+            &self.socket,
+            "agent.prompt_guarded",
+            serde_json::json!({
+                "target": pane,
+                "server_epoch": epoch,
+                "guard": guard,
+                "operation_id": operation_id,
+                "expires_at_unix_ms": expires,
+                "text": text,
+            }),
+        );
+        let mut state = first["result"]["state"].as_str().unwrap_or("").to_string();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while state == "pending" && Instant::now() < deadline {
+            thread::sleep(Duration::from_millis(50));
+            let receipt = rpc(
+                &self.socket,
+                "agent.prompt_receipt",
+                serde_json::json!({ "server_epoch": epoch, "operation_id": operation_id }),
+            );
+            state = receipt["result"]["state"]
+                .as_str()
+                .unwrap_or("")
+                .to_string();
+        }
+        state
+    }
+
+    fn finish(self) {
+        cleanup_spawned_herdr(self.herdr, self.base);
+    }
+}
+
+fn rpc(socket: &Path, method: &str, params: serde_json::Value) -> serde_json::Value {
+    send_request(
+        socket,
+        &serde_json::json!({ "id": method, "method": method, "params": params }).to_string(),
+    )
+}
+
+fn pasted(text: &str) -> String {
+    format!("\x1b[200~{text}\x1b[201~\r")
+}
+
+#[test]
+fn guarded_list_admits_direct_claude_with_hook_session_and_clear_screen() {
+    let fixture = Fixture::start();
+    let pane = fixture.workspace_pane.clone();
+    fixture.set_mode("claude", "plain");
+    fixture.run(&pane, "claude");
+    fixture.wait_for_status(&pane, "claude", "idle");
+    assert_eq!(
+        fixture.guard(&pane).1,
+        None,
+        "a direct Claude without a hook-reported session must stay draft-only"
+    );
+
+    fixture.report_session(&pane);
+    fixture.wait_for_guard(&pane, true);
+    let info = fixture.agent(&pane).expect("agent");
+    assert_ne!(info["interactive_ready"], true, "Herdr did not launch it");
+    assert_ne!(info["launch_pending"], true);
+
+    fixture.set_mode("claude", "blocked");
+    fixture.wait_for_status(&pane, "claude", "blocked");
+    fixture.wait_for_guard(&pane, false);
+    fixture.set_mode("claude", "plain");
+    fixture.wait_for_guard(&pane, true);
+
+    // A pane whose foreground agent is not Claude stays excluded, even with a Claude report.
+    let other = fixture.split();
+    fixture.set_mode("pi", "plain");
+    fixture.run(&other, "pi");
+    assert!(wait_until(
+        Duration::from_secs(10),
+        Duration::from_millis(100),
+        || fixture
+            .agent(&other)
+            .is_some_and(|info| info["agent"] == "pi")
+    ));
+    fixture.report_session(&other);
+    thread::sleep(Duration::from_millis(500));
+    assert_eq!(fixture.guard(&other).1, None);
+    fixture.finish();
+}
+
+#[test]
+fn guarded_prompt_rejects_claude_outside_vim_insert_mode() {
+    let fixture = Fixture::start();
+    let vim = fixture.workspace_pane.clone();
+    fixture.set_mode("vim", "insert");
+    fixture.run(&vim, "claude vim");
+    fixture.wait_for_status(&vim, "claude", "idle");
+    fixture.report_session(&vim);
+    let guard = fixture.wait_for_guard(&vim, true);
+
+    assert_eq!(fixture.prompt(&vim, &guard, "in insert"), "accepted");
+    assert!(wait_until(
+        Duration::from_secs(3),
+        Duration::from_millis(50),
+        || fixture.input("vim").ends_with(&pasted("in insert"))
+    ));
+
+    // NORMAL mode shows no indicator; once this process showed one, that is a refusal.
+    fixture.set_mode("vim", "normal");
+    fixture.wait_for_screen(&vim, "? for shortcuts");
+    let before = fixture.input("vim");
+    assert_eq!(fixture.prompt(&vim, &guard, "in normal"), "rejected");
+    fixture.set_mode("vim", "visual");
+    fixture.wait_for_screen(&vim, "-- VISUAL --");
+    assert_eq!(fixture.prompt(&vim, &guard, "in visual"), "rejected");
+    thread::sleep(Duration::from_millis(300));
+    assert_eq!(
+        fixture.input("vim"),
+        before,
+        "no rejected byte reached the PTY"
+    );
+
+    fixture.set_mode("vim", "insert");
+    fixture.wait_for_screen(&vim, "-- INSERT --");
+    assert_eq!(fixture.prompt(&vim, &guard, "insert again"), "accepted");
+
+    // A Claude that never showed a vim indicator keeps its send path.
+    let plain = fixture.split();
+    fixture.set_mode("plain", "plain");
+    fixture.run(&plain, "claude plain");
+    fixture.wait_for_status(&plain, "claude", "idle");
+    fixture.report_session(&plain);
+    let plain_guard = fixture.wait_for_guard(&plain, true);
+    assert_eq!(fixture.prompt(&plain, &plain_guard, "no vim"), "accepted");
+    assert!(wait_until(
+        Duration::from_secs(3),
+        Duration::from_millis(50),
+        || fixture.input("plain").ends_with(&pasted("no vim"))
+    ));
+    fixture.finish();
+}
+
+#[test]
+fn guarded_list_excludes_claude_while_its_managed_launch_is_pending() {
+    let fixture = Fixture::start();
+    let pane = fixture.workspace_pane.clone();
+    fixture.set_mode("managed", "starting");
+    let socket = fixture.socket.clone();
+    let start_pane = pane.clone();
+    let launch = thread::spawn(move || {
+        rpc(
+            &socket,
+            "agent.start",
+            serde_json::json!({
+                "pane_id": start_pane,
+                "kind": "claude",
+                "name": "fixture-claude",
+                "args": ["managed"],
+                "timeout_ms": 20_000,
+            }),
+        )
+    });
+    assert!(wait_until(
+        Duration::from_secs(10),
+        Duration::from_millis(100),
+        || fixture
+            .agent(&pane)
+            .is_some_and(|info| info["launch_pending"] == true)
+    ));
+    fixture.report_session(&pane);
+    assert!(wait_until(
+        Duration::from_secs(5),
+        Duration::from_millis(100),
+        || fixture.agent(&pane).is_some_and(|info| {
+            info["launch_pending"] == true && info["agent_session"].is_object()
+        })
+    ));
+    assert_eq!(
+        fixture.guard(&pane).1,
+        None,
+        "a pending launch is never guarded"
+    );
+
+    fixture.set_mode("managed", "insert");
+    let started = launch.join().unwrap();
+    assert!(started.get("result").is_some(), "{started}");
+    let guard = fixture.wait_for_guard(&pane, true);
+    assert_eq!(fixture.agent(&pane).unwrap()["interactive_ready"], true);
+
+    // The vim check covers managed sessions too.
+    fixture.set_mode("managed", "normal");
+    fixture.wait_for_screen(&pane, "? for shortcuts");
+    assert_eq!(fixture.prompt(&pane, &guard, "managed normal"), "rejected");
+    fixture.set_mode("managed", "insert");
+    fixture.wait_for_screen(&pane, "-- INSERT --");
+    assert_eq!(fixture.prompt(&pane, &guard, "managed insert"), "accepted");
+    fixture.finish();
+}
