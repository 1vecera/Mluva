index 00000000..1530788f
--- /dev/null
+++ b/src/app/api/guarded_prompts.rs
@@ -0,0 +1,362 @@
+//! Guarded, expiring, idempotent prompt submission for local accessibility clients.
+//! Receipts describe PTY acceptance, never completion of an agent turn.
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use super::responses::{encode_error, encode_success};
+use crate::api::schema::{
+    AgentInfo, AgentPromptGuardedParams, AgentPromptReceiptParams, GuardedAgent,
+    PromptReceiptState, ResponseResult,
+};
+use crate::app::App;
+use sha2::{Digest, Sha256};
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis() as u64
+}
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+struct Receipt {
+    digest: String,
+    expires: u64,
+    state: Arc<Mutex<PromptReceiptState>>,
+}
+pub(crate) struct GuardedPrompts {
+    epoch: String,
+    receipts: HashMap<String, Receipt>,
+}
+impl Default for GuardedPrompts {
+    fn default() -> Self {
+        Self {
+            epoch: format!(
+                "{}-{}",
+                std::process::id(),
+                SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .unwrap_or_default()
+                    .as_nanos()
+            ),
+            receipts: HashMap::new(),
+        }
+    }
+}
+impl GuardedPrompts {
+    fn reserve(
+        &mut self,
+        params: &AgentPromptGuardedParams,
+    ) -> Result<(Arc<Mutex<PromptReceiptState>>, bool), &'static str> {
+        let now = now_ms();
+        self.receipts.retain(|_, receipt| receipt.expires > now);
+        let hash = digest(&serde_json::to_vec(params).map_err(|_| "invalid request")?);
+        if let Some(receipt) = self.receipts.get(&params.operation_id) {
+            return if receipt.digest == hash {
+                Ok((receipt.state.clone(), false))
+            } else {
+                Err("operation ID already belongs to another request")
+            };
+        }
+        if params.server_epoch != self.epoch
+            || params.expires_at_unix_ms <= now
+            || params.expires_at_unix_ms > now.saturating_add(30_000)
+            || params.operation_id.len() != 36
+            || !params
+                .operation_id
+                .bytes()
+                .all(|b| b.is_ascii_hexdigit() || b == b'-')
+            || params.text.trim().is_empty()
+            || params.text.len() > 32768
+            || params
+                .text
+                .chars()
+                .any(|c| c.is_control() && c != '\n' && c != '\t')
+        {
+            return Err("invalid, expired or stale guarded prompt");
+        }
+        if self.receipts.len() >= 1024
+            || self
+                .receipts
+                .values()
+                .filter(|r| {
+                    *r.state.lock().unwrap_or_else(|p| p.into_inner())
+                        == PromptReceiptState::Pending
+                })
+                .count()
+                >= 8
+        {
+            return Err("guarded prompt capacity reached");
+        }
+        let state = Arc::new(Mutex::new(PromptReceiptState::Pending));
+        self.receipts.insert(
+            params.operation_id.clone(),
+            Receipt {
+                digest: hash,
+                expires: now.saturating_add(600_000),
+                state: state.clone(),
+            },
+        );
+        Ok((state, true))
+    }
+}
+
+impl App {
+    #[cfg(unix)]
+    fn guarded_identity(
+        &self,
+        agent: &AgentInfo,
+    ) -> Option<(
+        String,
+        crate::pty::actor::InputSubmissionGuard,
+        crate::detect::Agent,
+    )> {
+        if agent.launch_pending || agent.agent_session.is_none() {
+            return None;
+        }
+        let resolved = self.resolve_agent_target(&agent.pane_id).ok()?;
+        let runtime = self.lookup_runtime_sender(resolved.ws_idx, resolved.pane_id)?;
+        let shell = runtime.child_pid()?;
+        let (kind, _, pid) =
+            crate::detect::identify_agent_process_in_job(&crate::detect::foreground_job(shell)?)?;
+        if !matches!(
+            kind,
+            crate::detect::Agent::Claude | crate::detect::Agent::Codex
+        ) {
+            return None;
+        }
+        // A directly launched Codex session has no managed-launch readiness bit.
+        // Require its current empty composer before admitting it; all process,
+        // session, expiry and submission-time checks below remain unchanged.
+        if !agent.interactive_ready
+            && (kind != crate::detect::Agent::Codex
+                || !crate::pane::codex_prompt_ready(&runtime.detection_text()))
+        {
+            return None;
+        }
+        let start = crate::platform::process_start_token(pid)?;
+        let group = crate::platform::foreground_process_group_id(shell)?;
+        let guard = digest(
+            &serde_json::to_vec(&(
+                &self.guarded_prompts.epoch,
+                &agent.terminal_id,
+                &agent.pane_id,
+                &agent.name,
+                &agent.agent_session,
+                pid,
+                start,
+                group,
+            ))
+            .ok()?,
+        );
+        let check = Arc::new(move || {
+            crate::platform::process_start_token(pid) == Some(start)
+                && crate::platform::foreground_process_group_id(shell) == Some(group)
+                && crate::detect::foreground_job(shell)
+                    .and_then(|job| crate::detect::identify_agent_process_in_job(&job))
+                    .is_some_and(|(current, _, current_pid)| current == kind && current_pid == pid)
+        });
+        Some((guard, check, kind))
+    }
+
+    pub(super) fn handle_agent_guarded_list(&mut self, id: String) -> String {
+        #[cfg(unix)]
+        let agents = self
+            .collect_agent_infos()
+            .into_iter()
+            .filter_map(|agent| {
+                let (guard, _, _) = self.guarded_identity(&agent)?;
+                Some(GuardedAgent { agent, guard })
+            })
+            .collect();
+        #[cfg(not(unix))]
+        let agents = Vec::<GuardedAgent>::new();
+        encode_success(
+            id,
+            ResponseResult::AgentGuardedList {
+                server_epoch: self.guarded_prompts.epoch.clone(),
+                agents,
+            },
+        )
+    }
+
+    pub(super) fn handle_agent_prompt_receipt(
+        &mut self,
+        id: String,
+        params: AgentPromptReceiptParams,
+    ) -> String {
+        if params.server_epoch != self.guarded_prompts.epoch {
+            return encode_error(id, "stale_server", "the Herdr server restarted");
+        }
+        let Some(receipt) = self
+            .guarded_prompts
+            .receipts
+            .get(&params.operation_id)
+            .filter(|r| r.expires > now_ms())
+        else {
+            return encode_error(
+                id,
+                "receipt_unknown",
+                "no retained receipt; do not resend automatically",
+            );
+        };
+        let state = *receipt.state.lock().unwrap_or_else(|p| p.into_inner());
+        encode_success(
+            id,
+            ResponseResult::AgentPromptReceipt {
+                server_epoch: self.guarded_prompts.epoch.clone(),
+                operation_id: params.operation_id,
+                state,
+            },
+        )
+    }
+
+    pub(super) fn handle_agent_prompt_guarded(
+        &mut self,
+        id: String,
+        params: AgentPromptGuardedParams,
+    ) -> String {
+        let (state, fresh) = match self.guarded_prompts.reserve(&params) {
+            Ok(value) => value,
+            Err(message) => return encode_error(id, "guarded_prompt_rejected", message),
+        };
+        if fresh {
+            // Nothing leaves the process if validation or worker creation fails.
+            if !self.queue_guarded_prompt(&params, state.clone()) {
+                *state.lock().unwrap_or_else(|p| p.into_inner()) = PromptReceiptState::Rejected;
+            }
+        }
+        let result = *state.lock().unwrap_or_else(|p| p.into_inner());
+        encode_success(
+            id,
+            ResponseResult::AgentPromptReceipt {
+                server_epoch: self.guarded_prompts.epoch.clone(),
+                operation_id: params.operation_id,
+                state: result,
+            },
+        )
+    }
+
+    #[cfg(unix)]
+    fn queue_guarded_prompt(
+        &mut self,
+        params: &AgentPromptGuardedParams,
+        state: Arc<Mutex<PromptReceiptState>>,
+    ) -> bool {
+        let Ok(agent) = self.agent_info_for_target(&params.target) else {
+            return false;
+        };
+        if agent.pane_id != params.target
+            || matches!(
+                agent.agent_status,
+                crate::api::schema::AgentStatus::Blocked | crate::api::schema::AgentStatus::Unknown
+            )
+        {
+            return false;
+        }
+        let Some((guard, identity, kind)) = self.guarded_identity(&agent) else {
+            return false;
+        };
+        if guard != params.guard {
+            return false;
+        }
+        let Ok(resolved) = self.resolve_agent_target(&params.target) else {
+            return false;
+        };
+        let Some(runtime) = self.lookup_runtime_sender(resolved.ws_idx, resolved.pane_id) else {
+            return false;
+        };
+        if !runtime.bracketed_paste_enabled() {
+            return false;
+        }
+        let expiry = params.expires_at_unix_ms;
+        let valid = Arc::new(move || now_ms() < expiry && identity());
+        let (tx, rx) = std::sync::mpsc::channel::<std::sync::mpsc::Receiver<std::io::Result<()>>>();
+        if crate::thread_spawn::spawn_named("herdr-guarded-prompt", move || {
+            let Ok(completion) = rx.recv() else {
+                return;
+            };
+            // Any failure after queuing may follow a partial PTY write. Never label it safe to retry.
+            let result = match completion.recv_timeout(Duration::from_secs(31)) {
+                Ok(Ok(())) => PromptReceiptState::Accepted,
+                _ => PromptReceiptState::Uncertain,
+            };
+            *state.lock().unwrap_or_else(|p| p.into_inner()) = result;
+        })
+        .is_err()
+        {
+            return false;
+        }
+        let (text, enter) =
+            crate::app::api_helpers::encode_api_submission_parts(runtime, &params.text);
+        match runtime.queue_guarded_user_input_submission(
+            text.into(),
+            enter.into(),
+            Duration::from_millis(300),
+            valid,
+            kind,
+        ) {
+            Ok(completion) => {
+                let _ = tx.send(completion);
+                true
+            }
+            Err(_) => false,
+        }
+    }
+
+    #[cfg(not(unix))]
+    fn queue_guarded_prompt(
+        &mut self,
+        _: &AgentPromptGuardedParams,
+        _: Arc<Mutex<PromptReceiptState>>,
+    ) -> bool {
+        false
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn request(ledger: &GuardedPrompts) -> AgentPromptGuardedParams {
+        AgentPromptGuardedParams {
+            target: "w1:p1".into(),
+            server_epoch: ledger.epoch.clone(),
+            guard: "instance".into(),
+            operation_id: "12345678-1234-1234-1234-123456789012".into(),
+            expires_at_unix_ms: now_ms() + 10_000,
+            text: "Synthetic message".into(),
+        }
+    }
+    #[test]
+    fn receipts_deduplicate_and_reject_conflicting_retries() {
+        let mut ledger = GuardedPrompts::default();
+        let params = request(&ledger);
+        let (state, fresh) = ledger.reserve(&params).unwrap();
+        assert!(fresh);
+        *state.lock().unwrap() = PromptReceiptState::Accepted;
+        let (retry, fresh) = ledger.reserve(&params).unwrap();
+        assert!(!fresh);
+        assert_eq!(*retry.lock().unwrap(), PromptReceiptState::Accepted);
+        let mut changed = params.clone();
+        changed.text.push('!');
+        assert!(ledger.reserve(&changed).is_err());
+    }
+    #[test]
+    fn stale_expired_control_and_oversized_input_never_reserve() {
+        let mut ledger = GuardedPrompts::default();
+        for change in 0..5 {
+            let mut params = request(&ledger);
+            match change {
+                0 => params.server_epoch.push('x'),
+                1 => params.expires_at_unix_ms = 0,
+                2 => params.text = "\u{1b}[201~\n".into(),
+                3 => params.text = "x".repeat(32769),
+                _ => params.text.clear(),
+            }
+            assert!(ledger.reserve(&params).is_err());
+        }
+        assert!(ledger.receipts.is_empty());
+    }
+}
