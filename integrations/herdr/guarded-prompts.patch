+/// Claude Code's vim-mode indicator on the line under its prompt box.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ClaudeVimFooter {
+    /// `-- INSERT --`: typed and pasted text becomes composer text.
+    Insert,
+    /// `-- VISUAL --` or `-- VISUAL LINE --`: keys act on a selection.
+    Visual,
+    /// Claude shows its paste notice in place of the indicator.
+    Pasting,
+    /// No indicator. Vim mode is off, in NORMAL mode or hidden, or no prompt box shows.
+    Absent,
+}
+
+impl ClaudeVimFooter {
+    /// Only a vim-enabled Claude draws `-- INSERT --` or `-- VISUAL --`.
+    pub(crate) fn shows_vim_mode(self) -> bool {
+        matches!(self, Self::Insert | Self::Visual)
+    }
+}
+
+/// Reads Claude's footer: the line under the lowest horizontal rule near the bottom.
+/// Blank rows under the last drawn line are skipped, since a short session leaves them.
+pub(crate) fn claude_vim_footer(content: &str) -> ClaudeVimFooter {
+    let mut below_rule = None;
+    for line in content
+        .lines()
+        .rev()
+        .skip_while(|line| line.trim().is_empty())
+        .take(12)
+    {
+        if crate::detect::manifest::is_horizontal_rule(line) {
+            return below_rule.map_or(ClaudeVimFooter::Absent, classify_claude_footer);
+        }
+        below_rule = Some(line);
+    }
+    ClaudeVimFooter::Absent
+}
+
+fn classify_claude_footer(line: &str) -> ClaudeVimFooter {
+    let footer = line.trim_start();
+    if footer.starts_with("-- INSERT --") {
+        ClaudeVimFooter::Insert
+    } else if footer.starts_with("-- VISUAL") {
+        ClaudeVimFooter::Visual
+    } else if footer.starts_with("Pasting…") || footer.starts_with("paste again to expand") {
+        ClaudeVimFooter::Pasting
+    } else {
+        ClaudeVimFooter::Absent
+    }
+}
+
+/// Decides whether Claude's composer may take the next guarded write.
+/// A process that has shown a vim indicator must show `-- INSERT --` before the text,
+/// because NORMAL mode shows nothing and would read pasted text as commands.
+/// Later writes also accept Claude's own paste notice. VISUAL mode is always refused.
+#[cfg(unix)]
+pub(crate) fn claude_composer_accepts(
+    footer: ClaudeVimFooter,
+    vim_mode_seen: bool,
+    write: crate::pty::actor::GuardedWrite,
+) -> bool {
+    match footer {
+        ClaudeVimFooter::Insert => true,
+        ClaudeVimFooter::Visual => false,
+        ClaudeVimFooter::Pasting => {
+            !vim_mode_seen || write == crate::pty::actor::GuardedWrite::Continuation
+        }
+        ClaudeVimFooter::Absent => !vim_mode_seen,
+    }
+}
