+    #[cfg(unix)]
+    pub(crate) fn queue_guarded_user_input_submission(
+        &self,
+        text: Bytes,
+        enter: Bytes,
+        delay: std::time::Duration,
+        identity: crate::pty::actor::InputSubmissionGuard,
+        agent: Agent,
+    ) -> std::io::Result<std::sync::mpsc::Receiver<std::io::Result<()>>> {
+        let terminal = self.terminal.clone();
+        let guard = Arc::new(move || {
+            if !identity() || !terminal.bracketed_paste_enabled() {
+                return false;
+            }
+            let detection = crate::detect::detect_agent_with_osc(
+                Some(agent),
+                &terminal.detection_text(),
+                &terminal.agent_osc_title(),
+                &terminal.agent_osc_progress(),
+            );
+            !detection.visible_blocker
+                && !detection.skip_state_update
+                && matches!(detection.state, AgentState::Idle | AgentState::Working)
+        });
+        match &self.io {
+            PaneRuntimeIo::Actor(actor) => {
+                actor.queue_guarded_user_input_submission(text, enter, delay, Some(guard))
+            }
+            #[cfg(test)]
+            PaneRuntimeIo::TestChannel { .. } => {
+                Err(std::io::Error::other("guarded prompts require a real PTY"))
+            }
+        }
+    }
