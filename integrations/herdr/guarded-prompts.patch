+                Bytes::from_static(b"\r"),
+                Duration::from_millis(100),
+                Some(Arc::new(move |stage| {
+                    seen.lock().unwrap().push(stage);
+                    check.load(std::sync::atomic::Ordering::SeqCst)
+                })),
+            )
+            .unwrap();
+        let mut received = [0; 6];
+        peer.read_exact(&mut received).unwrap();
+        assert_eq!(&received, b"prompt");
+        allowed.store(false, std::sync::atomic::Ordering::SeqCst);
+        assert!(completion
+            .recv_timeout(Duration::from_secs(1))
+            .unwrap()
+            .is_err());
+        // The text start is checked as the first write; the refused Enter as a continuation.
+        assert_eq!(
+            *stages.lock().unwrap(),
+            [
+                crate::pty::actor::GuardedWrite::First,
+                crate::pty::actor::GuardedWrite::Continuation
+            ]
+        );
+        handle
+            .try_write_user_input(Bytes::from_static(b"alive"))
+            .unwrap();
+        let mut received = [0; 5];
+        peer.read_exact(&mut received).unwrap();
+        assert_eq!(&received, b"alive");
+        handle.shutdown();
+    }
+
