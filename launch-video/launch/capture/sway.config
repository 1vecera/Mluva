# Private sway for the launch takes: one 3840x2160 output at scale 2 (a 1920x1080 desktop, as on
# a HiDPI Omarchy laptop), Omarchy's gaps and 2 px borders in Vantablack's colours, a black
# background. No includes, bar, wallpaper, Xwayland, input or host configuration.
xwayland disable
output HEADLESS-1 resolution 3840x2160 position 0 0 scale 2 background #000000 solid_color
default_border pixel 2
default_floating_border pixel 2
gaps inner 10
gaps outer 0
client.focused #8d8d8d #000000 #ffffff #8d8d8d #8d8d8d
client.focused_inactive #595959aa #000000 #ffffff #595959aa #595959aa
client.unfocused #595959aa #000000 #ffffff #595959aa #595959aa
focus_follows_mouse no
seat * fallback true
swaybg_command -
