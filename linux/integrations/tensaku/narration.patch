diff --git c/src/narration.rs i/src/narration.rs
new file mode 100644
index 0000000..7f6fb24
--- /dev/null
+++ i/src/narration.rs
@@ -0,0 +1,231 @@
+//! Bounded text from an explicitly configured narration program; stdin closes when recording stops.
+
+use std::io::{Read, Write};
+use std::os::unix::process::CommandExt;
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, mpsc};
+use std::time::{Duration, Instant};
+
+const MAX_TEXT_CHARACTERS: usize = 120_000;
+const MAX_TEXT_BYTES: u64 = (MAX_TEXT_CHARACTERS * 4 + 1) as u64;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum NarrationState {
+    #[default]
+    Idle,
+    Selecting,
+    Recording,
+    Finishing,
+}
+
+impl NarrationState {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Idle => "Add narration",
+            Self::Selecting => "Choose text area",
+            Self::Recording => "Stop narration",
+            Self::Finishing => "Finishing narration…",
+        }
+    }
+}
+
+pub type NarrationResult = Result<String, String>;
+
+pub struct NarrationJob {
+    child: Arc<Mutex<Child>>,
+    stdin: Option<ChildStdin>,
+    cancelled: Arc<AtomicBool>,
+    finished: Arc<AtomicBool>,
+}
+
+fn kill_owned_group(child: &mut Child) {
+    // The command starts a new process group, including any recording helper it spawns.
+    if child.id() > 1
+        && let Some(pid) = rustix::process::Pid::from_raw(child.id() as i32)
+    {
+        let _ = rustix::process::kill_process_group(pid, rustix::process::Signal::KILL);
+    }
+}
+
+impl NarrationJob {
+    pub fn start(command: &str) -> std::io::Result<(Self, mpsc::Receiver<NarrationResult>)> {
+        // Treat the configured value as one executable, never a shell fragment.
+        let mut child = Command::new(command)
+            .process_group(0)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()?;
+        let stdout = child.stdout.take().expect("piped narration stdout");
+        let stdin = child.stdin.take();
+        let child = Arc::new(Mutex::new(child));
+        let worker_child = child.clone();
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let worker_cancelled = cancelled.clone();
+        let finished = Arc::new(AtomicBool::new(false));
+        let worker_finished = finished.clone();
+        let (sender, receiver) = mpsc::channel();
+        std::thread::spawn(move || {
+            let mut text = String::new();
+            let read = stdout.take(MAX_TEXT_BYTES).read_to_string(&mut text);
+            let result = if read.is_err()
+                || worker_cancelled.load(Ordering::SeqCst)
+                || text.chars().count() > MAX_TEXT_CHARACTERS
+                || text.trim().is_empty()
+            {
+                kill_owned_group(&mut worker_child.lock().unwrap());
+                Err("Narration did not return complete text. Try again.".to_owned())
+            } else {
+                let deadline = Instant::now() + Duration::from_secs(5);
+                loop {
+                    let status = worker_child.lock().unwrap().try_wait();
+                    match status {
+                        Ok(Some(status)) if status.success() => {
+                            break Ok(text.trim_end_matches(['\r', '\n']).to_owned());
+                        }
+                        Ok(Some(_)) | Err(_) => {
+                            break Err(
+                                "Narration was cancelled or failed. Your image is unchanged."
+                                    .to_owned(),
+                            );
+                        }
+                        Ok(None) if Instant::now() < deadline => {}
+                        Ok(None) => {
+                            kill_owned_group(&mut worker_child.lock().unwrap());
+                            break Err("Narration did not finish. Try again.".to_owned());
+                        }
+                    }
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+            };
+            let mut child = worker_child.lock().unwrap();
+            let _ = child.wait();
+            worker_finished.store(true, Ordering::SeqCst);
+            let _ = sender.send(result);
+        });
+        Ok((
+            Self {
+                child,
+                stdin,
+                cancelled,
+                finished,
+            },
+            receiver,
+        ))
+    }
+
+    pub fn stop(&mut self) {
+        if let Some(mut stdin) = self.stdin.take() {
+            let _ = stdin.write_all(b"stop\n");
+        }
+    }
+
+    pub fn cancel(&mut self) {
+        self.cancelled.store(true, Ordering::SeqCst);
+        let mut child = self.child.lock().unwrap();
+        if !self.finished.load(Ordering::SeqCst) {
+            kill_owned_group(&mut child);
+        }
+        self.stdin.take();
+    }
+}
+
+impl Drop for NarrationJob {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+    use std::path::PathBuf;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    fn program(body: &str) -> PathBuf {
+        let directory = PathBuf::from("tmp/narration-tests");
+        std::fs::create_dir_all(&directory).unwrap();
+        let id = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let path = directory.join(format!("program-{}-{id}", std::process::id()));
+        std::fs::write(&path, format!("#!/bin/sh\n{body}\n")).unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o700)).unwrap();
+        path
+    }
+
+    #[test]
+    fn stop_returns_verbatim_unicode_from_the_independent_program() {
+        let path = program(
+            "read request\n[ \"$request\" = stop ] || exit 1\nprintf 'Česká poznámka\\nSecond line\\n'",
+        );
+        let (mut job, result) = NarrationJob::start(path.to_str().unwrap()).unwrap();
+        assert!(matches!(result.try_recv(), Err(mpsc::TryRecvError::Empty)));
+        job.stop();
+        assert_eq!(
+            result
+                .recv_timeout(Duration::from_secs(2))
+                .unwrap()
+                .unwrap(),
+            "Česká poznámka\nSecond line"
+        );
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn cancellation_discards_output_and_reaps_the_owned_program() {
+        let path = program("read request\nprintf 'Must not be inserted'");
+        let (mut job, result) = NarrationJob::start(path.to_str().unwrap()).unwrap();
+        job.cancel();
+        assert!(
+            result
+                .recv_timeout(Duration::from_secs(2))
+                .unwrap()
+                .is_err()
+        );
+        assert!(job.child.lock().unwrap().try_wait().unwrap().is_some());
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn oversized_output_is_rejected_without_truncating_the_annotation() {
+        let path = program("head -c 480010 /dev/zero | tr '\\000' x");
+        let (_job, result) = NarrationJob::start(path.to_str().unwrap()).unwrap();
+        assert!(
+            result
+                .recv_timeout(Duration::from_secs(2))
+                .unwrap()
+                .is_err()
+        );
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn cancellation_stops_a_recording_child_even_when_it_keeps_stdout_open() {
+        let path = program("sleep 30 &\nprintf '%s' \"$!\" > \"$0.child\"\nread request");
+        let marker = PathBuf::from(format!("{}.child", path.display()));
+        let (mut job, result) = NarrationJob::start(path.to_str().unwrap()).unwrap();
+        let deadline = Instant::now() + Duration::from_secs(2);
+        while !marker.exists() && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        let pid = std::fs::read_to_string(&marker)
+            .unwrap()
+            .parse::<u32>()
+            .unwrap();
+        job.cancel();
+        assert!(
+            result
+                .recv_timeout(Duration::from_secs(2))
+                .unwrap()
+                .is_err()
+        );
+        let state = std::fs::read_to_string(format!("/proc/{pid}/stat"));
+        assert!(state.is_err() || state.unwrap().rsplit(')').next().unwrap().starts_with(" Z"));
+        std::fs::remove_file(path).unwrap();
+        std::fs::remove_file(marker).unwrap();
+    }
+}
