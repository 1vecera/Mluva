#!/usr/bin/env bash
set -euo pipefail
application_dir="@APPLICATION_DIR@"

has_elevenlabs_credential() {
    [[ -n "${ELEVENLABS_API_KEY:-}" ]] \
        || [[ -n "${DAS_ITEM_ELEVEN_LABS_API_KEY__CREDENTIAL:-}" ]] \
        || [[ -n "${ELEVEN_LABS_STT_TOKEN:-}" ]]
}

needs_elevenlabs_credential() {
    local config_path="${XDG_CONFIG_HOME:-${HOME}/.config}/mluva/config.json"
    [[ ! -f "${config_path}" ]] && return 0
    /usr/bin/python3 - "${config_path}" <<'PYCONFIG'
import json
import sys
try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        provider = json.load(stream).get("transcription_provider", "elevenlabs")
except (OSError, ValueError, AttributeError):
    provider = "elevenlabs"
sys.exit(0 if provider == "elevenlabs" else 1)
PYCONFIG
}

if needs_elevenlabs_credential && [[ "${MLUVA_SECRET_PROFILE:-}" != "1" ]] && ! has_elevenlabs_credential; then
    secret_config_dir="${DAS_CONF_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/daniel-ai-skills}"
    managed_launcher="${secret_config_dir}/bin/das-mcp-launch"
    profile_references="${secret_config_dir}/env/mluva.env"
    if [[ -x "${managed_launcher}" && -s "${profile_references}" ]]; then
        exec "${managed_launcher}" mluva -- env MLUVA_SECRET_PROFILE=1 "$0" "$@"
    fi
    agent_launcher="${secret_config_dir}/bin/das-agent-launch"
    if [[ -x "${agent_launcher}" && -s "${secret_config_dir}/env/agent.env" ]]; then
        exec "${agent_launcher}" --only \
            "${MLUVA_AGENT_SECRET_NAME:-DAS_ITEM_ELEVEN_LABS_API_KEY__CREDENTIAL}" -- \
            env MLUVA_SECRET_PROFILE=1 "$0" "$@"
    fi
fi

exec env PYTHONPATH="${application_dir}" "${application_dir}/.venv/bin/python" -m mluva_linux.app "$@"
