{
  "schemaVersion": 1,
  "id": "mluva.dictation",
  "name": "Mluva dictation",
  "version": "2.2.2",
  "author": "Mluva contributors",
  "license": "Apache-2.0",
  "description": "Theme-aware dictation preview and direct conversation rewrites; requires the bundled Mluva app",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "linux/quickshell/mluva.dictation/Widget.qml" },
  "barWidget": {
    "displayName": "Mluva",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "command": "mluva-shell" },
    "schema": [{ "key": "command", "type": "string", "label": "Mluva shell executable" }]
  }
}
